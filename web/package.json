{
  "name": "airhockey-interactive-article",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data:export": "node scripts/export-data.mjs",
    "data:check": "node scripts/export-data.mjs --check && node scripts/check-assets.mjs",
    "check": "npm run data:check && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/science.test.mjs",
    "test:browser": "playwright test",
    "build": "npm run data:check && vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "katex": "^0.16.22",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  }
}
